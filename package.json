{
  "name": "diagramble",
  "private": true,
  "type": "module",
  "license": "BUSL-1.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "node scripts/check-comment-history.mjs && node scripts/check-boundaries.mjs",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=75 --test-coverage-branches=75 --test-coverage-functions=75 --test-coverage-exclude='scripts/**/*.test.mjs' scripts/ && vitest run --coverage",
    "build": "npm run build --workspaces --if-present",
    "test:browser": "npm run test:browser --workspaces --if-present"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
